# ==============================================================================
# Buildbox — Exemplar Local Environment Template
# ==============================================================================
# Copy to `.env` for local overrides, or let `.devcontainer/init-host.sh`
# bootstrap `.env` automatically on first run.
#
# SECURITY: `.env` is gitignored and blocked by `scripts/git-hooks/pre-commit`.
# Never commit real API keys, SSH credentials, or production passwords here.
# ==============================================================================

# Local Devcontainer PostgreSQL & Redis defaults (container-only dev services)
POSTGRES_USER=buildbox
POSTGRES_PASSWORD=changeme-local-dev-only
POSTGRES_DB=buildbox
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/1

# Set to 1 to force SwiftShader software WebGL in Chromium even on GPU hosts
BUILDBOX_CHROME_SOFTWARE_GL=0

# Optional sibling private repo directory for raw host snapshots (e.g., ostree diff)
# Defaults automatically to ../buildbox-private if present, else ./.local/state
# BUILDBOX_PRIVATE_DIR=../buildbox-private
